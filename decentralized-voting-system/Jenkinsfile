pipeline {
    agent any
    environment {
        PROJECT_DIR = 'decentralized-voting-system'
    }
    stages {
        stage('Checkout Code') {
            steps {
                echo 'Checking out SecureVote code...'
                git branch: 'main', url: 'https://github.com/LAKSHY-007/ByteBug-Project.git'
            }
        }
        
        stage('Setup Python') {
            steps {
                echo 'Setting up Python manually...'
                sh '''
                sudo apt-get update
                sudo apt-get install -y python3.10 python3-pip
                python3 --version
                pip3 --version
                '''
            }
        }
        
        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                dir(env.PROJECT_DIR) {
                    sh '''
                    pip3 install -r requirements.txt
                    pip3 install pytest web3 flask cryptography
                    '''
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                echo 'Running tests...'
                dir(env.PROJECT_DIR) {
                    sh 'python3 -m pytest tests/ -v --junitxml=test-results.xml'
                }
            }
            post {
                always {
                    junit "${env.PROJECT_DIR}/test-results.xml"
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                echo 'Running security scan...'
                dir(env.PROJECT_DIR) {
                    sh '''
                    pip3 install bandit
                    bandit -r . -f html -o security-scan.html || true
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: "${env.PROJECT_DIR}/security-scan.html"
                }
            }
        }
    }
    post {
        always {
            echo "Build completed: ${currentBuild.result}"
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
